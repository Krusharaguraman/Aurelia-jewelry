# ------------------------------------------------------------------
#  Aurelia Jewelry — ENV TEMPLATE  (single source of truth)
#  Copy this file to .env.local for local dev, and paste the same
#  values into Vercel / Render "Environment Variables".
#  NEVER commit real secrets (.env.local is git-ignored).
# ------------------------------------------------------------------

# --- Site URL (used for JSON-LD schema / SEO absolute URLs) ---
# Local dev: http://localhost:3000
# Production: https://aurelia-jewelry.com  (or your Vercel/render domain)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI Assistant (Groq) ---
# Get a key: https://console.groq.com/keys
GROQ_API_KEY=your key

# --- Contact info shown across the site ---
NEXT_PUBLIC_CONTACT_EMAIL=contact@aureli.com                  # changed to aureli domain
NEXT_PUBLIC_CONTACT_PHONE=+91 9876543210                      # sample number
NEXT_PUBLIC_WHATSAPP_NUMBER=9876543210                        # same sample

# --- Per-store contacts (sample numbers/emails) ---
NEXT_PUBLIC_STORE_PHONE_CHENNAI=+91 9876543211
NEXT_PUBLIC_STORE_EMAIL_CHENNAI=chennai@aureli.com
NEXT_PUBLIC_STORE_PHONE_BENGALURU=+91 9876543212
NEXT_PUBLIC_STORE_EMAIL_BENGALURU=bengaluru@aureli.com
NEXT_PUBLIC_STORE_PHONE_MUMBAI=+91 9876543213
NEXT_PUBLIC_STORE_EMAIL_MUMBAI=mumbai@aureli.com

# --- Social links (contact page + footer) ---
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/aurelia_jewelry
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/aureliajewelry
NEXT_PUBLIC_TWITTER_URL=https://twitter.com/aureliajewelry
NEXT_PUBLIC_YOUTUBE_URL=https://youtube.com/@aureliajewelry

# --- Homepage hero background image ---
NEXT_PUBLIC_HERO_IMAGE=https://images.pexels.com/photos/1191531/pexels-photo-1191531.jpeg?auto=compress&cs=tinysrgb&w=1920

# --- Email (SMTP) — optional; Telegram below is the fallback ---
# Gmail example: SMTP_USER=you@gmail.com  SMTP_PASS=<16-char App Password>
# App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
SMTP_FROM=

# --- Telegram bot notification (fallback for contact/custom-design/newsletter) ---
# Token from @BotFather, chat id from getUpdates.
TELEGRAM_BOT_TOKEN=your token # unchanged
TELEGRAM_CHAT_ID=your id                                        # unchanged